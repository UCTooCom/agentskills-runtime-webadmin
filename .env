VITE_CONTEXT=/vue-pro/
VITE_BASE_API=/api
VITE_SERVER_HOST=https://javatoarktsapi.uctoo.com
VITE_MOCK_HOST=https://javatoarktsapi.uctoo.com
VITE_USE_MOCK=false
VITE_MOCK_IGNORE=
VITE_MOCK_SERVER_HOST=https://javatoarktsapi.uctoo.com
VITE_BASE=/
VITE_OUT_DIR=../dist
VITE_BACKEND_URL=https://javatoarktsapi.uctoo.com

# AI Chat 配置
# WebSocket 直连后端(不受 CORS 限制) - 使用 Runtime 的 WebSocket 聊天端点
VITE_WS_URL=wss://javatoarktsapi.uctoo.com/api/v1/uctoo/ws/chat
# 后端根地址(用于 Vite 代理)
VITE_AGENT_ROOT=https://javatoarktsapi.uctoo.com
# LLM API Key(agentskills-runtime 可能不验证,填占位值即可)
VITE_OPENAI_API_KEY=sk-dummy-key
# LLM baseURL - 使用完整的后端地址（备用，主要使用WebSocket）
VITE_OPENAI_BASE_URL=https://javatoarktsapi.uctoo.com/api/v1/uctoo
# 使用 OrbitAI gpt-5.4 模型
VITE_OPENAI_MODEL=gpt-5.4

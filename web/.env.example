# Application context path
VITE_CONTEXT=/vue-pro/

# API base path
VITE_BASE_API=/api

# Server host (replace with your actual server URL)
VITE_SERVER_HOST=https://javatoarktsapi.uctoo.com

# Mock host (replace with your actual mock server URL)
VITE_MOCK_HOST=https://javatoarktsapi.uctoo.com

# Use mock data (true/false)
VITE_USE_MOCK=false

# Mock ignore paths (comma separated)
VITE_MOCK_IGNORE=

# Mock server host
VITE_MOCK_SERVER_HOST=https://javatoarktsapi.uctoo.com

# Base path
VITE_BASE=/

# Output directory
VITE_OUT_DIR=../dist

# Backend API URL
VITE_BACKEND_URL=https://javatoarktsapi.uctoo.com